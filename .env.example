# Copy to .env and fill in. Never commit .env.
# Preview and production values live in Vercel → Project → Settings → Environment Variables
# (Neon's Vercel integration sets DATABASE_URL per preview branch automatically).

# Postgres (local: docker compose up -d db)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/handup"

# Auth: at least 32 random characters. Generate with: openssl rand -base64 32
JWT_SECRET=""
